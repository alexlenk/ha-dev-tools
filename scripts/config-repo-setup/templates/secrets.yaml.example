# Copy this file to secrets.yaml (already gitignored - never commit that
# one) and fill in real values. Reference them elsewhere via
# `!secret key_name`, e.g. `password: !secret wifi_password`.
#
# Keep every key used anywhere in your config listed here too, with a
# placeholder value - this file is what CI uses to run `check_config`
# without your real secrets, so a key missing here fails CI the same way a
# key missing from the real secrets.yaml would fail Home Assistant.

wifi_password: "changeme"
api_token: "changeme"
